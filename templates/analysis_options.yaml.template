# Analysis options — REPLACE:FLUTTER_PROJECT_NAME
#
# Baseline for Flutter Agent OS projects. The analyzer is a gate, not advice:
# `flutter analyze` must report ZERO issues, including infos.
#
# A rule that does not fit this project is disabled here with a comment saying
# why. A growing list of tolerated warnings is the same as having no analyzer.

include: package:REPLACE:FLUTTER_LINT_PACKAGE/analysis_options.yaml

# Analyzer plugins (stack-specific lints such as riverpod_lint) go under this
# TOP-LEVEL key — not under `analyzer:`. They then run inside `dart analyze`,
# so no extra CI step is needed.
#
# `custom_lint` has ended maintenance. If you inherit a project wired that way,
# note that a `custom_lint` step running nothing still exits 0 and reads as a
# pass. bloc_lint is the exception: it still ships its own `bloc lint` CLI.
#
# plugins:
#   riverpod_lint: ^X.Y.Z          # check pub.dev for the current version

analyzer:
  language:
    strict-casts: true
    strict-inference: true
    strict-raw-types: true

  errors:
    # Correctness issues that must never merge.
    invalid_annotation_target: ignore   # noise from freezed/json_serializable
    missing_required_param: error
    missing_return: error
    dead_code: error
    unused_import: error
    unused_local_variable: error
    unused_field: error
    body_might_complete_normally_nullable: error

    # Discipline rules promoted from warning to error.
    avoid_print: error
    prefer_const_constructors: error
    prefer_const_literals_to_create_immutables: error
    unawaited_futures: error
    use_build_context_synchronously: error
    close_sinks: error
    cancel_subscriptions: error
    always_use_package_imports: ignore  # this project uses relative imports within lib/

  exclude:
    - "**/*.g.dart"
    - "**/*.freezed.dart"
    - "**/*.mocks.dart"
    - "**/generated_plugin_registrant.dart"
    - "lib/core/l10n/generated/**"
    - "build/**"

linter:
  rules:
    # Immutability and const
    prefer_const_constructors: true
    prefer_const_declarations: true
    prefer_final_fields: true
    prefer_final_locals: true
    prefer_final_in_for_each: true

    # Async safety
    unawaited_futures: true
    avoid_void_async: true
    use_build_context_synchronously: true
    cancel_subscriptions: true
    close_sinks: true
    discarded_futures: true

    # Type discipline
    avoid_dynamic_calls: true
    always_declare_return_types: true
    avoid_returning_null_for_void: true
    prefer_null_aware_operators: true
    tighten_type_of_initializing_formals: true

    # Correctness
    avoid_slow_async_io: true
    no_adjacent_strings_in_list: true
    test_types_in_equals: true
    throw_in_finally: true
    unnecessary_statements: true
    literal_only_boolean_expressions: true

    # API hygiene
    avoid_equals_and_hash_code_on_mutable_classes: true
    avoid_field_initializers_in_const_classes: true
    one_member_abstracts: false          # repository interfaces are legitimately single-method
    sort_constructors_first: true
    use_super_parameters: true

    # Readability
    avoid_print: true
    avoid_unnecessary_containers: true
    sized_box_for_whitespace: true
    use_colored_box: true
    use_decorated_box: true
    prefer_single_quotes: true
    directives_ordering: true
    require_trailing_commas: true

    # Documentation on shared surfaces
    public_member_api_docs: false        # enable in shared packages

    # Deliberately disabled — record the reason next to each
    lines_longer_than_80_chars: false    # formatter governs width
    flutter_style_todos: false           # TODO(owner): ... — enforced by review, not this rule
