#!/usr/bin/env bash
# FLUTTER_AGENT_OS_HOOK
# pre-push: last cheap gate before work leaves the machine.
#
# Adopter app with a Flutter test tree → `flutter test`.
# This framework repository → `framework-verify.sh` + `self-test.sh`.
# Neither → report unverified and allow (do not invent a green suite).

set -uo pipefail

AOS_ROOT="__FLUTTER_AGENT_OS_ROOT__"
REPO="$(git rev-parse --show-toplevel)"
cd "$REPO" || exit 0

REMOTE_REF="${2:-}"
case "$REMOTE_REF" in
  *main|*master)
    printf 'pre-push: pushing to a protected branch\n' ;;
esac

# Framework source tree: skills + scripts, no app pubspec at root.
if [ -f "$REPO/skills/README.md" ] && [ -f "$REPO/scripts/self-test.sh" ] \
   && [ ! -f "$REPO/pubspec.yaml" ]; then
  printf 'pre-push: framework suite (framework-verify + self-test)\n'
  if ! bash "$REPO/scripts/framework-verify.sh"; then
    cat >&2 <<'EOF'

pre-push BLOCKED: framework-verify failed.

Fix the framework. Do not delete or weaken a check to get past this.
EOF
    exit 1
  fi
  if ! bash "$REPO/scripts/self-test.sh"; then
    cat >&2 <<'EOF'

pre-push BLOCKED: self-test failed.

Fix the framework. Do not delete or weaken a check to get past this.
EOF
    exit 1
  fi
  printf 'pre-push ok\n'
  LOCAL="$(dirname "$0")/pre-push.local"
  [ -x "$LOCAL" ] && exec "$LOCAL" "$@"
  exit 0
fi

if [ ! -d "$REPO/test" ] && [ ! -d "$REPO/integration_test" ]; then
  printf 'pre-push: no test/ or integration_test/ — tests NOT run (unverified, not passed)\n' >&2
  LOCAL="$(dirname "$0")/pre-push.local"
  [ -x "$LOCAL" ] && exec "$LOCAL" "$@"
  exit 0
fi

if ! command -v flutter >/dev/null 2>&1; then
  printf 'pre-push: flutter not on PATH — tests NOT run (unverified, not passed)\n' >&2
  exit 0
fi

printf 'pre-push: running flutter test\n'
OUT="$(flutter test 2>&1)"
CODE=$?

if [ "$CODE" -ne 0 ]; then
  printf '%s\n' "$OUT" | tail -30 >&2
  cat >&2 <<'EOF'

pre-push BLOCKED: tests are failing.

Fix the code. Do not delete, skip or weaken the test to get past this —
that converts a visible failure into an invisible one.
EOF
  exit 1
fi

printf '%s\n' "$OUT" | grep -E 'All tests passed|[0-9]+ tests? passed' | tail -1
printf 'pre-push ok\n'

LOCAL="$(dirname "$0")/pre-push.local"
[ -x "$LOCAL" ] && exec "$LOCAL" "$@"

exit 0
