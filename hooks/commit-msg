#!/usr/bin/env bash
# FLUTTER_AGENT_OS_HOOK
# commit-msg: rejects AI attribution, enforces subject shape, warns on a missing
# task reference.
#
# Attribution lines are rejected rather than stripped here, so the author sees
# what happened. prepare-commit-msg does the silent removal.

set -uo pipefail

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

FAILED=0
bad()  { FAILED=1; printf 'BLOCKED: %s\n' "$1" >&2; }
warn() { printf 'warning: %s\n' "$1" >&2; }

# Strip comments for analysis.
BODY="$(grep -v '^#' "$MSG_FILE" || true)"
SUBJECT="$(printf '%s\n' "$BODY" | sed '/^[[:space:]]*$/d' | head -1)"

[ -z "$SUBJECT" ] && { bad "empty commit message"; exit 1; }

# ------------------------------------------------------------- attribution
if printf '%s' "$BODY" | grep -qiE '(generated with|co-authored-by: *(claude|cursor|copilot|chatgpt|gpt|gemini|ai)|🤖|authored by an ai|written by (an )?ai)'; then
  bad "AI attribution line in the commit message. Remove it — commit history records what changed, not which tool typed it."
fi

# ----------------------------------------------------------------- subject
LEN="${#SUBJECT}"
if [ "$LEN" -gt 72 ]; then
  bad "subject is ${LEN} characters (max 72): ${SUBJECT}"
fi

case "$SUBJECT" in
  *.) warn "subject ends with a period" ;;
esac

# Imperative-mood heuristic on the leading verb.
FIRSTWORD="$(printf '%s' "$SUBJECT" | sed -E 's/^[A-Z]+-[0-9]+: *//; s/^[a-z]+(\([^)]*\))?: *//' | awk '{print tolower($1)}')"
case "$FIRSTWORD" in
  added|fixed|updated|removed|changed|refactored|implemented|created|adding|fixing|updating|removing)
    warn "subject starts with '${FIRSTWORD}' — use the imperative: add, fix, update, remove" ;;
esac

# ---------------------------------------------------------- task reference
if ! printf '%s' "$SUBJECT" | grep -qE '^([A-Z][A-Z0-9]+-[0-9]+|F[0-9]+-T[0-9]+)[: ]|^[a-z]+(\([^)]+\))?:'; then
  warn "no task reference or conventional-commit type in the subject"
  warn "expected '<PREFIX>-<n>: subject', 'F<n>-T<k>: subject', or 'type: subject'"
fi

# ------------------------------------------------------- chained local hook
LOCAL="$(dirname "$0")/commit-msg.local"
[ -x "$LOCAL" ] && { "$LOCAL" "$MSG_FILE" || FAILED=1; }

[ "$FAILED" -ne 0 ] && exit 1
exit 0
